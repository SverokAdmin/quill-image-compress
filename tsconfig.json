{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": ["node"],
    "lib": ["es2020", "dom"]
  },
  "include": ["src/index.ts"]
}
