{
	"name": "@sverokadmin/quill-image-compress",
	"description": "A Quill rich text editor Module which compresses images uploaded to the editor",
	"version": "2.0.0",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./dist/quill.imageCompressor.min.js": "./dist/quill.imageCompressor.min.js",
		"./package.json": "./package.json"
	},
	"unpkg": "./dist/quill.imageCompressor.min.js",
	"jsdelivr": "./dist/quill.imageCompressor.min.js",
	"repository": "https://github.com/SverokAdmin/quill-image-compress",
	"author": "Emil Forslund <emil@sverokadmin.se>",
	"license": "MIT",
	"scripts": {
		"check": "tsc --noEmit",
		"test": "npm run build && node --test test/*.test.mjs",
		"build": "node build.mjs",
		"prepare": "npm run build"
	},
	"files": [
		"dist/index.js",
		"dist/index.cjs",
		"dist/quill.imageCompressor.min.js",
		"dist/types",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"quill",
		"quilljs",
		"image",
		"compress",
		"compression",
		"reduce"
	],
	"peerDependencies": {
		"quill": "^2.0.3"
	},
	"devDependencies": {
		"@types/node": "^20.19.0",
		"esbuild": "^0.25.0",
		"jsdom": "26.1.0",
		"quill": "2.0.3",
		"typescript": "5.5.4"
	}
}
